# 복사해서 .env로 쓴다: cp .env.example .env
# 아래 기본값은 infra/docker-compose.yml의 로컬 개발 환경에 맞춰져 있다.

# ── Server ──────────────────────────────
SERVER_PORT=3000
WEB_ORIGIN=http://localhost:5173

# ── Database / Cache ────────────────────
DATABASE_URL=postgresql://metacode:metacode@localhost:5433/metacode
REDIS_URL=redis://localhost:6379

# ── File storage (S3 호환, 로컬은 SeaweedFS) ─
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=metacode-uploads
S3_ACCESS_KEY=metacode
S3_SECRET_KEY=metacode-secret
UPLOAD_MAX_SIZE_MB=50

# ── Auth (Phase 1) ──────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
JWT_SECRET=

# ── Web ─────────────────────────────────
VITE_API_URL=http://localhost:3000
