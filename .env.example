# 복사해서 .env로 쓴다: cp .env.example .env
# 아래 기본값은 infra/docker-compose.yml의 로컬 개발 환경에 맞춰져 있다.

# ── Server ──────────────────────────────
SERVER_PORT=3000
# 브라우저와 GitHub가 서버에 접속하는 주소 (OAuth 콜백 URL = PUBLIC_SERVER_URL/auth/github/callback)
PUBLIC_SERVER_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# ── Database / Cache ────────────────────
DATABASE_URL=postgresql://metacode:metacode@localhost:5433/metacode
REDIS_URL=redis://localhost:6379

# ── File storage (S3 호환, 로컬은 SeaweedFS) ─
# 서버가 접속하는 주소. 브라우저용 주소가 다르면 S3_PUBLIC_ENDPOINT도 적는다 (로컬은 같아서 생략).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=metacode-uploads
S3_ACCESS_KEY=metacode
S3_SECRET_KEY=metacode-secret
UPLOAD_MAX_SIZE_MB=50

# ── Voice (LiveKit, 로컬은 infra/docker-compose.yml의 livekit) ─
# 서버가 LiveKit API에 접속하는 주소와, 브라우저가 접속하는 주소(로컬은 같아서 생략). 비우면 음성 통화만 꺼진다.
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=metacode-dev-livekit-secret-0123456789

# ── Auth ────────────────────────────────
# GitHub → Settings → Developer settings → OAuth Apps에서 만든 앱의 값.
# 비워 두면 서버는 뜨지만 GitHub 로그인이 503을 돌려준다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32자 이상 무작위 값. 예: openssl rand -base64 48
JWT_SECRET=

# ── Web ─────────────────────────────────
VITE_API_URL=http://localhost:3000
