# 도메인마다 HTTPS 인증서(Let's Encrypt)를 자동으로 받고 갱신한다.
# *.localhost 도메인이면 Caddy 내부 인증서를 쓴다 (로컬 확인용).
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# 웹: 빌드된 정적 파일. 없는 경로는 index.html로 보낸다 (SPA).
{$APP_DOMAIN} {
	import security_headers
	encode zstd gzip
	root * /srv/web
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

# API + WebSocket(Socket.IO). WebSocket 업그레이드는 reverse_proxy가 알아서 처리한다.
# /livekit 아래는 음성 서버의 신호 연결이다 (Phase 5, 음성을 켜지 않았으면 502).
{$API_DOMAIN} {
	import security_headers
	handle_path /livekit/* {
		reverse_proxy livekit:7880
	}
	reverse_proxy server:3000
}

# 파일 저장소(S3 API). 첨부 파일 업로드/다운로드용 presigned URL이 이 주소를 쓴다 (Phase 3).
{$FILES_DOMAIN} {
	import security_headers
	reverse_proxy seaweedfs:9000
}
