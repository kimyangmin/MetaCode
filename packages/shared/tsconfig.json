{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    // URL, URLSearchParams처럼 브라우저와 Node에 모두 있는 전역을 쓰기 위해 DOM 타입을 포함한다.
    "lib": ["ES2023", "DOM"],
    "types": []
  },
  "include": ["src"]
}
