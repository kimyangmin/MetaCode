// Prisma 7: 접속 URL은 prisma.config.ts에 있다.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid(7)) @db.Uuid
  githubId    BigInt   @unique @map("github_id")
  username    String
  /// GitHub 프로필 이름 (로그인마다 GitHub 기준으로 맞춤, 화면에는 쓰지 않음)
  displayName String?  @map("display_name")
  /// GitHub 프로필 사진 (로그인마다 맞춤)
  avatarUrl   String   @map("avatar_url")
  /// 다른 사람에게 보이는 닉네임. null이면 username
  nickname    String?
  /// 자기소개
  bio         String?
  /// 직접 올린 프로필 사진의 저장소 키 (avatars/<userId>/<id>.webp). null이면 GitHub 사진
  avatarKey   String?  @map("avatar_key")
  /// 움직이는 사진(GIF 등)을 올렸으면 움직이는 WebP의 키 (avatars/<userId>/<id>-animated.webp).
  /// avatarKey는 첫 장면만 담은 멈춘 사진이다 (채팅 목록 등은 멈춘 사진, 멤버 목록·정보 팝업은 움직이는 사진)
  avatarAnimatedKey String? @map("avatar_animated_key")
  /// 광장 캐릭터 {asset, colors, version?}. null이면 사용자 ID로 고른 기본 캐릭터
  character   Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  refreshTokens          RefreshToken[]
  ownedCommunities       Community[]
  memberships            CommunityMember[]
  invitesCreated         Invite[]
  channelMemberships     ChannelMember[]
  messages               Message[]
  readStates             ChannelReadState[]
  attachments            Attachment[]
  assets                 Asset[]
  friendRequestsSent     Friendship[]       @relation("FriendRequester")
  friendRequestsReceived Friendship[]       @relation("FriendAddressee")

  @@index([username])
  @@map("users")
}

enum FriendshipStatus {
  /// 요청을 보냈고 상대가 아직 받지 않음
  PENDING
  /// 서로 친구
  ACCEPTED
}

/// 친구 관계. 두 사람 사이에 한 줄만 둔다 (반대 방향 줄이 있으면 그것을 쓴다).
/// 거절·취소·친구 끊기는 줄을 지운다.
model Friendship {
  requesterId String           @map("requester_id") @db.Uuid
  addresseeId String           @map("addressee_id") @db.Uuid
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  acceptedAt  DateTime?        @map("accepted_at")

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@id([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friendships")
}

enum CommunityRole {
  OWNER
  ADMIN
  MEMBER
}

enum ChannelType {
  TEXT
  VOICE
  DM
  GROUP_DM
}

model Community {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  ownerId   String   @map("owner_id") @db.Uuid
  /// 올린 아이콘·배너의 저장소 키 (communities/<id>/<종류>-<무작위>.webp). 없으면 null
  iconKey   String?  @map("icon_key")
  bannerKey String?  @map("banner_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner    User              @relation(fields: [ownerId], references: [id])
  members  CommunityMember[]
  channels Channel[]
  invites  Invite[]
  roles    Role[]
  assets   Asset[]
  map      CommunityMap?

  @@map("communities")
}

model CommunityMember {
  communityId String        @map("community_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        CommunityRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at")

  community Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     MemberRole[]

  @@id([communityId, userId])
  @@index([userId])
  @@map("community_members")
}

/// 커뮤니티가 만든 역할 (Discord식). 비공개 채널을 어떤 역할에게 보여 줄지 정하는 데 쓴다.
/// 소유자와 관리자(CommunityMember.role)는 역할과 상관없이 모든 채널을 본다.
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  communityId String   @map("community_id") @db.Uuid
  name        String
  /// #rrggbb. 멤버 이름 색
  color       String?
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  community Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  members   MemberRole[]
  channels  ChannelRoleAccess[]

  @@unique([communityId, name])
  @@map("roles")
}

model MemberRole {
  communityId String @map("community_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid
  roleId      String @map("role_id") @db.Uuid

  member CommunityMember @relation(fields: [communityId, userId], references: [communityId, userId], onDelete: Cascade)
  role   Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, userId])
  @@index([communityId, userId])
  @@map("member_roles")
}

/// 비공개 채널을 볼 수 있는 역할
model ChannelRoleAccess {
  channelId String @map("channel_id") @db.Uuid
  roleId    String @map("role_id") @db.Uuid

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([channelId, roleId])
  @@index([roleId])
  @@map("channel_role_access")
}

model Invite {
  code        String    @id
  communityId String    @map("community_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  expiresAt   DateTime? @map("expires_at")
  uses        Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@map("invites")
}

/// 커뮤니티 채널(TEXT, VOICE)은 communityId가 있고, DM/GROUP_DM은 없다.
/// DM/GROUP_DM 참여자는 ChannelMember에, 커뮤니티 채널 접근은 CommunityMember로 판단한다.
model Channel {
  id             String      @id @default(uuid(7)) @db.Uuid
  type           ChannelType
  communityId    String?     @map("community_id") @db.Uuid
  name           String?
  position       Int         @default(0)
  proximityVoice Boolean     @default(false) @map("proximity_voice")
  /// 비공개 채널: 소유자, 관리자, roleAccess의 역할을 가진 멤버만 본다 (커뮤니티 채널만)
  private        Boolean     @default(false)
  /// 1:1 DM 중복 방지: 두 사용자 ID를 정렬해 이은 값
  dmKey          String?     @unique @map("dm_key")
  createdAt      DateTime    @default(now()) @map("created_at")

  community   Community?          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  members     ChannelMember[]
  messages    Message[]
  readStates  ChannelReadState[]
  attachments Attachment[]
  roleAccess  ChannelRoleAccess[]

  @@index([communityId])
  @@map("channels")
}

model ChannelMember {
  channelId String   @map("channel_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
  @@map("channel_members")
}

/// id는 UUIDv7이라 생성 순서대로 정렬된다. 페이지네이션은 (channelId, id) 인덱스로 한다.
model Message {
  id        String    @id @default(uuid(7)) @db.Uuid
  channelId String    @map("channel_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  content   String
  /// 답장한 메시지. 원래 메시지가 지워지면 비운다
  replyToId String?   @map("reply_to_id") @db.Uuid
  /// 다른 곳에서 전달한 메시지
  forwarded Boolean   @default(false)
  /// 작성자가 글을 고친 시각 (고치지 않았으면 null)
  editedAt  DateTime? @map("edited_at")
  createdAt DateTime  @default(now()) @map("created_at")

  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  replyTo     Message?     @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]    @relation("Replies")

  @@index([channelId, id(sort: Desc)])
  @@map("messages")
}

model ChannelReadState {
  channelId         String   @map("channel_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  lastReadMessageId String   @map("last_read_message_id") @db.Uuid
  updatedAt         DateTime @updatedAt @map("updated_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@map("channel_read_states")
}

/// 리프레시 토큰은 해시만 저장한다. 같은 로그인에서 이어지는 토큰은 familyId를 공유하고,
/// 이미 교체된 토큰이 다시 쓰이면(탈취 의심) 그 family 전체를 폐기한다.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  client    String
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum AttachmentStatus {
  /// 올릴 주소만 발급했고 아직 확인하지 않음
  PENDING
  /// 저장소에 올라온 것을 확인함 (이미지는 썸네일까지 만듦). 메시지에 붙일 수 있다.
  READY
}

enum AttachmentKind {
  IMAGE
  FILE
}

/// 파일 자체는 S3 호환 저장소에 있고, 여기에는 위치와 정보만 둔다.
/// 채널에 묶어 두어 권한은 채널 접근 권한으로 판단한다. 메시지에 붙기 전에는 messageId가 없다.
model Attachment {
  id           String           @id @default(uuid(7)) @db.Uuid
  channelId    String           @map("channel_id") @db.Uuid
  uploaderId   String           @map("uploader_id") @db.Uuid
  messageId    String?          @map("message_id") @db.Uuid
  status       AttachmentStatus @default(PENDING)
  kind         AttachmentKind   @default(FILE)
  objectKey    String           @map("object_key")
  thumbnailKey String?          @map("thumbnail_key")
  fileName     String           @map("file_name")
  contentType  String           @map("content_type")
  size         Int
  width        Int?
  height       Int?
  createdAt    DateTime         @default(now()) @map("created_at")

  channel  Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([status, createdAt])
  @@map("attachments")
}

enum AssetKind {
  TILE
  OBJECT
  CHARACTER
}

/// 도트 에디터로 만든 에셋. 캐릭터는 만든 사람의 것(communityId null),
/// 타일·오브젝트는 커뮤니티의 것(소유자·관리자가 만들고 고침)
model Asset {
  id          String    @id @default(uuid(7)) @db.Uuid
  kind        AssetKind
  name        String
  creatorId   String    @map("creator_id") @db.Uuid
  communityId String?   @map("community_id") @db.Uuid
  /// 에셋 매니페스트 (packages/shared의 assetManifestSchema로 검증한 JSON)
  manifest    Json
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  creator   User       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([creatorId, kind])
  @@index([communityId])
  @@map("assets")
}

/// 맵 에디터로 만든 커뮤니티 광장의 맵. 없으면 내장 분수 광장을 쓴다.
/// 충돌 격자는 저장하지 않고 맵 정의와 에셋에서 계산한다 (서버 메모리에 캐시).
model CommunityMap {
  communityId String   @id @map("community_id") @db.Uuid
  /// 맵 정의 (packages/shared의 mapDefinitionSchema로 검증한 JSON)
  definition  Json
  updatedAt   DateTime @updatedAt @map("updated_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@map("community_maps")
}
