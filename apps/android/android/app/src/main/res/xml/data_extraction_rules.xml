<?xml version="1.0" encoding="utf-8"?>
<!-- 안드로이드 12부터의 백업 규칙: 로그인 쿠키가 들어 있는 앱 데이터를 클라우드 백업·기기 이전에서 뺀다 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
