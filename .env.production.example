# 운영 서버용 환경변수. 서버에서 복사해서 채운다:
#   cp .env.production.example .env.production
# 비밀값은 무작위로 만든다 (URL에 들어가도 안전하도록 hex):
#   openssl rand -hex 32

# ── 도메인 ──────────────────────────────
# 세 도메인 모두 DNS A 레코드가 서버 공인 IP를 가리켜야 HTTPS 인증서를 받을 수 있다.
APP_DOMAIN=metacode.kimyangmin.me
API_DOMAIN=api.metacode.kimyangmin.me
FILES_DOMAIN=files.metacode.kimyangmin.me
# HTTPS 인증서(Let's Encrypt) 관련 알림을 받을 이메일
ACME_EMAIL=

# ── GitHub OAuth App (운영용, 개발용과 따로 만든다) ──
# Homepage URL:               https://<APP_DOMAIN>
# Authorization callback URL: https://<API_DOMAIN>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── 비밀값 (openssl rand -hex 32) ────────
JWT_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=metacode
S3_SECRET_KEY=

# ── 음성 통화 (docs/deploy.md 10단계) ─────
# 비워 두면 음성 통화만 꺼진다. 켤 때는 포트(7881/tcp, 7882/udp)를 연 뒤 아래 세 줄을 채운다.
#   키: 영문·숫자 아무 이름 (예: metacode), 비밀값: openssl rand -hex 32
# COMPOSE_PROFILES=voice
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# ── 선택 ─────────────────────────────────
# 첨부 파일 최대 크기 (MB, 기본 50)
# UPLOAD_MAX_SIZE_MB=50
